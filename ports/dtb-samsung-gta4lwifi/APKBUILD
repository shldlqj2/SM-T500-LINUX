88599ffdec96d150c1feb9b261ba93bb0301a9d0e1ad6bef7aeab1f5372cbfc57d8b43c7e902bd8f76921d1dbd8189663c142ea869e51d0e2b483b150ee00fe0  linux-6.18.tar.xz
54de3b136047554b64dfcea421649979dccab7ffdf00f4af60abcf8cf8650f6359021e5c7291c71fab5a6bfe79ea439375b064a9989aa6a1c597da1f4689c3f6  sm6115-samsung-gta4lwifi.dts
"
