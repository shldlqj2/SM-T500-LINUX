# SPDX-License-Identifier: MIT
# N2 정적 준비물. 이 패키지는 bootloader 선택 계약을 제공하지 않는다.
pkgname=dtb-samsung-gta4lwifi
pkgver=0.1
pkgrel=0
pkgdesc="Experimental SM-T500 Wi-Fi DT for Nura LTS 6.18.35"
url="https://nura.eco"
license="GPL-2.0-or-later AND BSD-3-Clause"
arch="noarch"
options="!check"
makedepends="gcc dtc"
source="
	patch-6.18.35.patch.xz::https://cdn.kernel.org/pub/linux/kernel/v6.x/patch-6.18.35.xz
	linux-6.18.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.tar.xz
	sm6115-samsung-gta4lwifi.dts
"
builddir="$srcdir/linux-6.18"

build() {
	gcc -E -P -nostdinc -undef -D__DTS__ -x assembler-with-cpp \
		-I arch/arm64/boot/dts/qcom -I include -I scripts/dtc/include-prefixes \
		-o "$srcdir/board.preprocessed.dts" "$srcdir/sm6115-samsung-gta4lwifi.dts"
	dtc -I dts -O dtb -@ -o "$srcdir/sm6115-samsung-gta4lwifi.dtb" \
		"$srcdir/board.preprocessed.dts"
}

package() {
	install -Dm644 "$srcdir/sm6115-samsung-gta4lwifi.dtb" \
		"$pkgdir/boot/dtbs/qcom/sm6115-samsung-gta4lwifi.dtb"
}

sha512sums="
